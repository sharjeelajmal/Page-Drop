# Template only: copy to .env (or .env.local) and fill in real values there.
# Never put real secrets in this file; it is committed to git.

# MongoDB connection string (stores project metadata and Cloudinary URLs only)
MONGODB_URI=

# Cloudinary credentials (server-side only; never exposed to the browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: fixed site URL used in generated page links, e.g. https://pages.example.com
# Leave empty to use whatever domain the app is opened on (localhost in dev,
# your real domain when live), so nothing needs changing between environments.
NEXT_PUBLIC_APP_URL=

# Dashboard login (/login). Required: the dashboard and API are admin-only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign login sessions.
AUTH_SECRET=

# Optional second login that can see and manage locked projects (admin never sees them).
PRIVATE_USERNAME=
PRIVATE_PASSWORD=
